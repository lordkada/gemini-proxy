# Copy to .env and adjust. .env is git-ignored: never commit it.

# Key that clients (opencode, curl, ...) must send to the proxy.
# The proxy only listens on 127.0.0.1, but set your own random value anyway, e.g.:
#   openssl rand -hex 16
PROXY_API_KEY=change-me

# Ports on 127.0.0.1 of your machine.
PROXY_PORT=8081
BROWSER_PORT=3000

# Model used when a client asks for a name the proxy does not know.
DEFAULT_MODEL=gemini-3.6-flash

# true: conversations are sent as Gemini "temporary chats" and do not show up
# in your Gemini history. Set to false to keep them (useful for debugging).
TEMPORARY_CHATS=true

# How often (seconds) the session is refreshed from the browser.
SYNC_INTERVAL_SEC=600

# Only if you are signed in to several Google accounts in the proxy browser:
# the N in https://gemini.google.com/u/N/app of the account to use.
GEMINI_AUTH_USER=

# Linux only: your user/group ids (run `id -u` and `id -g`), and your timezone.
PUID=1000
PGID=1000
TZ=Etc/UTC
